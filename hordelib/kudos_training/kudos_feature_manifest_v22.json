        "normal_bae",
        "oneformer_ade20k",
        "oneformer_coco",
        "openpose",
        "pidinet",
        "pyracanny",
        "recolor_intensity",
        "recolor_luminance",
        "scribble",
        "scribble_pidinet",
        "scribble_xdog",
        "seg",
        "shuffle",
        "standard_lineart",
        "teed",
        "tile",
        "tile_ttplanet_guided",
        "tile_ttplanet_simple",
        "zoe_depth"
      ],
      "unknown_collapse": "None",
      "default": "None",
      "description": "ControlNet preprocessor, snapshotting CONTROLNET_IMAGE_PREPROCESSOR_MAP plus the None entry."
    },
    {
      "kind": "categorical",
      "name": "source_processing",
      "payload_keys": [
        "source_processing"
      ],
      "vocabulary": [
        "img2img",
        "inpainting",
        "outpainting",
        "txt2img"
      ],
      "value_aliases": {
        "remix": "img2img"
      },
      "unknown_collapse": "txt2img",
      "default": "txt2img",
      "description": "How the source image is consumed. `remix` is aliased onto img2img, matching how the server prices it today."
    },
    {
      "kind": "multihot",
      "name": "post_processing",
      "payload_keys": [
        "post_processing"
      ],
      "vocabulary": [
        "4x_AnimeSharp",
        "CodeFormers",
        "GFPGAN",
        "NMKD_Siax",
        "RealESRGAN_x2plus",
        "RealESRGAN_x4plus",
        "RealESRGAN_x4plus_anime_6B",
        "strip_background"
      ],
      "description": "Post-processors requested, counting repeats. An entry outside this vocabulary is dropped and counted rather than collapsed, since no other post-processor prices like it."
    }
  ]
}
